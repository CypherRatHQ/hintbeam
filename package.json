{
  "name": "hintbeam",
  "version": "0.1.0",
  "description": "Guided flows and product tours for React, Next.js and React Native. Tours that find their elements, follow users across pages, and never break when the app scrolls or moves.",
  "license": "MIT",
  "author": "CypherRat HQ (https://github.com/CypherRatHQ)",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/web/index.js",
  "module": "./dist/web/index.js",
  "types": "./dist/web/index.d.ts",
  "react-native": "./dist/native/index.js",
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/native/index.d.ts",
        "default": "./dist/native/index.js"
      },
      "types": "./dist/web/index.d.ts",
      "default": "./dist/web/index.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "default": "./dist/web/index.js"
    },
    "./native": {
      "types": "./dist/native/index.d.ts",
      "default": "./dist/native/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./next": {
      "types": "./dist/routers/next.d.ts",
      "default": "./dist/routers/next.js"
    },
    "./react-router": {
      "types": "./dist/routers/react-router.d.ts",
      "default": "./dist/routers/react-router.js"
    },
    "./expo-router": {
      "types": "./dist/routers/expo-router.d.ts",
      "default": "./dist/routers/expo-router.js"
    },
    "./react-navigation": {
      "types": "./dist/routers/react-navigation.d.ts",
      "default": "./dist/routers/react-navigation.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "react-navigation/package.json",
    "expo-router/package.json",
    "react-router/package.json",
    "next/package.json",
    "core/package.json",
    "native/package.json",
    "web/package.json",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf dist && node node_modules/typescript/bin/tsc -p tsconfig.build.json && node scripts/subpaths.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run test && npm run api:check && npm run format:check",
    "prepublishOnly": "npm run check && npm run build",
    "api:check": "node scripts/api-surface.mjs",
    "api:update": "node scripts/api-surface.mjs --update",
    "changeset": "changeset",
    "version-packages": "changeset version && npm run format",
    "check:package": "publint && attw --pack . --profile esm-only"
  },
  "keywords": [
    "product-tour",
    "onboarding",
    "walkthrough",
    "guided-tour",
    "coach-marks",
    "spotlight",
    "react",
    "nextjs",
    "react-native",
    "expo",
    "typescript",
    "product tour",
    "user onboarding",
    "guided tour",
    "guided flows",
    "tooltip",
    "coachmarks",
    "next.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@react-navigation/native": ">=6",
    "expo-router": ">=3",
    "next": ">=13.4",
    "react": ">=18",
    "react-dom": ">=18",
    "react-native": ">=0.73",
    "react-native-svg": ">=13",
    "react-router": ">=6"
  },
  "peerDependenciesMeta": {
    "@react-navigation/native": {
      "optional": true
    },
    "expo-router": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    },
    "react-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@react-navigation/native": "^7.5.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/typescript6": "^6.0.2",
    "expo": "^57.0.27",
    "expo-router": "^57.0.25",
    "jsdom": "^30.1.2",
    "next": "^16.4.0",
    "prettier": "^3.9.9",
    "publint": "^0.3.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "^0.87.1",
    "react-native-svg": "^15.0.0",
    "react-router": "^8.4.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "homepage": "https://hintbeam.js.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CypherRatHQ/hintbeam.git"
  },
  "bugs": {
    "url": "https://github.com/CypherRatHQ/hintbeam/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
